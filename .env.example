# =============================================================================
# Variables d'environnement — Mindchain dApp
# Copier en `.env` et renseigner. Ne jamais versionner le fichier `.env`.
# =============================================================================

# --- Contrat -----------------------------------------------------------------
# Adresse du contrat MindchainContract sur Sepolia.
NEXT_PUBLIC_MINDCHAIN_ADDRESS=

# --- Portefeuille ------------------------------------------------------------
# Project ID Reown / WalletConnect (https://dashboard.reown.com).
NEXT_PUBLIC_PROJECT_ID=

# --- Authentification applicative (SIWE) -------------------------------------
# Signe les cookies de défi, de session et les reçus de propriété des CID.
# 32 caractères minimum. L'application refuse de démarrer sans cette valeur :
# une clé de repli codée en dur donnerait l'illusion d'une protection.
#   openssl rand -base64 48
AUTH_SECRET=

# URL publique de l'application. Doit correspondre au domaine réellement servi :
# elle apparaît dans le message EIP-4361 et est vérifiée par WalletConnect.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stockage IPFS -----------------------------------------------------------
# Compte Pinata utilisé pour épingler les œuvres et les métadonnées.
PINATA_JWT=
PINATA_GATEWAY=

# Passerelle de lecture IPFS (facultatif, valeur par défaut : gateway.pinata.cloud).
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# --- RPC ---------------------------------------------------------------------
# Utilisé côté serveur pour valider les signatures de comptes contrats
# (ERC-1271 / ERC-6492). Facultatif : les comptes externes sont vérifiés
# hors ligne.
INFURA_SEPOLIA_RPC_URL=

# --- Génération IA (hors périmètre du POC) -----------------------------------
# `src/services/generate.ts` et les SDK @google/genai et @huggingface/inference
# ont été retirés. Récupération du code : git show 6aa8094:src/services/generate.ts
# Ne réintroduire ces clés qu'une fois la génération authentifiée et adossée à
# un paiement on-chain vérifié.
# GEMINI_API_KEY=
# HUGGINGFACE_TOKEN=
